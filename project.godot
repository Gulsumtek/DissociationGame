; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Dissociation"
run/main_scene="res://Scenes/main_menu.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

TransitionScreen="*res://environment/transition_screen.tscn"
Global="*res://global.gd"
DialogueBox="*res://DialogueBox.tscn"
DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"
CutsceneManager="*res://Scenes/cutscene_manager.tscn"
BackgroundMusic="*res://Scenes/BackgroundMusic.tscn"
PauseMenu="*res://Scenes/pause_menu.tscn"
SoundManager="*res://Scenes/sound_manager.tscn"

[dialogic]

directories/dch_directory={}
directories/dtl_directory={}
layout/style_directory={}

[dialogue_manager]

general/balloon_path="res://dialogues/balloon.tscn"

[display]

window/size/viewport_width=720
window/size/viewport_height=360
window/stretch/mode="viewport"
window/canvas_textures/default_texture_filter=1

[dotnet]

project/assembly_name="Dissociation"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg")

[global_group]

Player=""

